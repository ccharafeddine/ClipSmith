{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ffprobe",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/yt-dlp",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "allow-probe-video",
    "allow-list-keyframes",
    "allow-export-clip",
    "allow-detect-encoder",
    "allow-available-formats",
    "allow-default-save-path",
    "allow-generate-filmstrip",
    "allow-generate-proxy",
    "allow-download-video",
    "allow-fetch-download",
    "allow-fetch-probe",
    "allow-fetch-download-hit",
    "allow-cancel-download",
    "allow-stop-recording",
    "allow-browse-open",
    "allow-browse-close",
    "allow-browse-hits",
    "allow-browse-save-signin",
    "allow-cookies-list",
    "allow-cookies-forget",
    "allow-cookies-import",
    "allow-fetch-settings-get",
    "allow-fetch-settings-set",
    "allow-tools-status",
    "allow-tools-update-now",
    "allow-check-for-update",
    "allow-analyze-subject",
    "allow-cancel-analyze"
  ]
}
